FROM php:8.1-cli WORKDIR /app # Installer extensions PHP RUN apt-get update && apt-get install -y \ git unzip libzip-dev libcurl4-openssl-dev libonig-dev libxml2-dev \ libpng-dev libjpeg-dev libfreetype6-dev libicu-dev zlib1g-dev \ && docker-php-ext-install pdo pdo_mysql zip mbstring curl bcmath xml gd intl # Copier le code Laravel COPY . . # Installer Composer RUN php -r "copy('https://getcomposer.org/installer','composer-setup.php');" \ && php composer-setup.php --install-dir=/usr/local/bin --filename=composer \ && php -r "unlink('composer-setup.php');" # Installer les dépendances PHP RUN composer install --no-dev --optimize-autoloader --ignore-platform-reqs # Permissions Laravel RUN chown -R www-data:www-data storage bootstrap/cache \ && chmod -R 775 storage bootstrap/cache # Exposer le port fourni par Railway EXPOSE ${PORT:-8000} # Lancer Laravel sur le port fourni par Railway CMD php artisan serve --host=0.0.0.0 --port=${PORT:-8000}
